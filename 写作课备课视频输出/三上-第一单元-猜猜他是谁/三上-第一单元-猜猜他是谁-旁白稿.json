          "chars": 35,
          "pause_after": 0.25
        },
        {
          "i": 8,
          "role": "why",
          "text": "这样能让学生先观察，再理解方法。",
          "chars": 16,
          "pause_after": 0.25
        }
      ],
      "chars": 198
    },
    {
      "id": "s17",
      "pages": [
