          "label": "背景设置",
          "children": [
            {
              "label": "场景：从伦敦达林家的育儿室，到永无乡海岛"
            },
            {
              "label": "主角：永远长不大的男孩彼得·潘，与达林家长女温迪"
            }
          ]
        },
        {
          "label": "主要内容",
          "children": [
            {
              "label": "彼得夜里飞进育儿室，教温迪三姐弟飞去永无乡"
            },
            {
              "label": "永无乡上有遗失的孩子们、仙子叮克铃、海盗胡克与鳄鱼"
            },
            {
              "label": "彼得与胡克斗智斗勇，决战中把胡克逼进鳄鱼口"
            },
            {
              "label": "孩子们飞回家、温迪长大，彼得却选择永远留下"
            }
          ]
        }
      ]
    },
    {
      "name": "书籍主题",
      "children": [
        {
          "label": "成长与选择：在“不肯长大”与“心甘情愿长大”之间，各有失也有得。"
        },
        {
          "label": "记忆与遗忘：彼得转身就忘、被母亲遗忘，牵出他不敢回家的隐痛。"
        },
        {
          "label": "守望的窗子：一扇窗的开与关，连着孩子能不能被接纳、能不能回家。"
        },
        {
          "label": "勇气与孤独：一句“去死是一次最大的冒险”，勇敢背后也藏着孤单。"
        }
      ]
    },
    {
      "name": "书籍特色",
      "children": [
        {
          "label": "带泪的喜剧：把童真的快乐和成长的忧伤揉在一起写。"
        },
        {
          "label": "反复的意象：窗子、橡子扣、滴答的鳄鱼一再出现，越读越有味。"
        },
        {
          "label": "一正一反的对照：彼得与胡克、温迪与彼得两两映照，见出人物。"
        },
        {
          "label": "幻想里的真情：会飞、仙子、海盗岛都是幻想，情感却是真的。"
        }
      ]
    },
    {
      "name": "阅读收获",
      "children": [
        {
          "label": "三段式脉络：理清“离家—历险—回家”，把整本书读成一条线。"
        },
        {
          "label": "从言行做推断：凭书里的线索，读出人物没有直说的心情。"
        },
        {
          "label": "学会做对照：用维恩图、故事地图把人物和情节比着看。"
        },
        {
          "label": "想清楚“长大”：既向往童真，也不惧长大——两样可以并存。"
        }
      ]
    }
