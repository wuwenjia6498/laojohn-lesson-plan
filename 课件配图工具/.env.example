# 复制为 .env 后填入真实值。.env 已被仓库根 .gitignore 拦截，禁止提交。
# 火山方舟控制台 → API Key
ARK_API_KEY=affabfaf-211e-4619-a092-2de18f29d4b9
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 生图模型（产品名 Doubao-Seedream-5.0-pro 对应的 model id）
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
# 视觉判读（自动初筛验收）用的多模态模型
ARK_VISION_MODEL=doubao-seed-2-1-pro-260628

# ===== 生图通道选择：gpt-image | gemini | doubao（2026-09-24 起缺省 gpt-image；只管新建项目，老项目按 project.通道／已有图目录走）=====
IMAGE_PROVIDER=gpt-image
# AiHubMix（Gemini 生图 + gpt-4o 判读）。密钥留空则回退取 picture-writing 的
# imggen.config.json（同账号，已 gitignored），回退时脚本会打印来源、不静默。
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_GEMINI_BASE=https://aihubmix.com/gemini
AIHUBMIX_VISION_MODEL=gpt-4o
# gemini-*-image-preview 走原生 genai，画幅用 aspect_ratio + image_size（1K/2K/4K）
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_IMAGE_SIZE=2K
